<?xml version="1.0" encoding="utf-8"?>
<!-- Widget reproductor (4×1): título, barra de avance y botones para atrasar, reproducir y adelantar. -->
<!-- RemoteViews no infla vistas de AppCompat: aquí solo vale android:tint. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    tools:ignore="UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_title"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_chapter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_chapter"
            android:textColor="@color/widget_secondary"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:max="1000"
            android:progress="350"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/widget_back">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_replay"
            android:tint="@color/widget_text" />

        <TextView
            android:id="@+id/widget_back_seconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no"
            android:text="15"
            android:textColor="@color/widget_text"
            android:textSize="8sp"
            android:textStyle="bold" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/widget_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="4dp"
        android:background="@drawable/widget_play_background"
        android:contentDescription="@string/widget_play"
        android:src="@drawable/ic_widget_play"
        android:tint="@color/widget_on_button" />

    <FrameLayout
        android:id="@+id/widget_forward"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/widget_forward">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleX="-1"
            android:src="@drawable/ic_widget_replay"
            android:tint="@color/widget_text" />

        <TextView
            android:id="@+id/widget_forward_seconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no"
            android:text="30"
            android:textColor="@color/widget_text"
            android:textSize="8sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
